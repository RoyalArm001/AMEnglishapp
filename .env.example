# MongoDB connection string for online database sync and cloud user profile
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="haylingo"

# Optional Google Search Console HTML-tag verification content (not the entire tag).
# Set before building/deploying. DNS-verified properties do not need this.
GOOGLE_SITE_VERIFICATION=""
